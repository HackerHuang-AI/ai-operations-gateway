<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.ai.operations.gateway</groupId>
        <artifactId>ai-operations-gateway</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>ai-operations-gateway-starter</artifactId>
    <name>ai-operations-gateway-starter</name>
    <description>启动层：主启动类、GlobalFilter、路由配置、资源文件</description>

    <dependencies>
        <!-- application 层（路由 Service、限流 Service）-->
        <dependency>
            <groupId>com.ai.operations.gateway</groupId>
            <artifactId>ai-operations-gateway-application</artifactId>
        </dependency>

        <dependency>
            <groupId>com.ai.operations.gateway</groupId>
            <artifactId>ai-operations-gateway-client</artifactId>
        </dependency>

        <!-- infrastructure：仅用于运行时装配（扫描 SessionStore/Provider 实现 Bean），业务代码不直接引用 -->
        <dependency>
            <groupId>com.ai.operations.gateway</groupId>
            <artifactId>ai-operations-gateway-infrastructure</artifactId>
        </dependency>

        <!-- Nacos 配置中心与服务发现 -->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-config</artifactId>
        </dependency>
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
        </dependency>

        <!-- Reactive Redis：Gateway 限流使用非阻塞客户端 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis-reactive</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-vault-config</artifactId>
        </dependency>

        <!-- Actuator（暴露 /actuator/prometheus 供 Prometheus 采集）-->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Micrometer Prometheus（指标上报）-->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <!-- 公共资源：resources/ 下的文件，开启 filtering 以替换 @...@ 占位符 -->
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
            <!-- 环境资源：把激活的 profiles/{env}/ 下所有文件复制到 classpath 根目录 -->
            <resource>
                <directory>src/main/profiles/${env}</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>dev</id>
            <activation>
                <!-- 不传 -P 时默认激活 dev -->
                <activeByDefault>true</activeByDefault>
            </activation>
            <properties>
                <env>dev</env>
                <spring.profiles.active>dev</spring.profiles.active>
            </properties>
        </profile>
        <profile>
            <id>test</id>
            <properties>
                <env>test</env>
                <spring.profiles.active>test</spring.profiles.active>
            </properties>
        </profile>
        <profile>
            <id>stag</id>
            <properties>
                <env>stag</env>
                <spring.profiles.active>stag</spring.profiles.active>
            </properties>
        </profile>
        <profile>
            <id>prod</id>
            <properties>
                <env>prod</env>
                <spring.profiles.active>prod</spring.profiles.active>
            </properties>
        </profile>
    </profiles>

</project>

